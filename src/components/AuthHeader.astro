---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="text-center">
  <div class="mb-2 flex justify-center">
    <img src="/logo.svg" alt="10xDevs Travel Logo" class="h-16 w-16" />
  </div>
  <h1 class="text-2xl font-bold text-gray-900">{title}</h1>
  <p class="mt-2 text-gray-600">Twój osobisty asystent planowania podróży</p>
</div>
